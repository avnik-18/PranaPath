# Copy to .env and fill. NEVER commit .env. Every variable must appear here with an empty value.

# ---- web (Vite: only VITE_* vars reach the browser) ----
# Empty = fixture mode (uses data/aqi_snapshot.json + bundled route fixtures)
VITE_API_BASE=
VITE_FIXTURE=true

# ---- backend ----
# Open-Meteo air quality is KEYLESS; keep this unset in local dev.
# OPENAQ_API_KEY=          # optional later: station-grade CPCB data
# BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# ---- AWS (team account; keys live ONLY here, never in code) ----
# Leave all three empty -> app runs the honest MOCK AWS view.
# Fill them -> probes go live (mode auto flips to live).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# AWS_PROFILE=
# ECOROUTE_AWS_MODE=auto   # auto | live | mock
# Deploy hint (leader): source these 3 lines into the runner before
#   python3 infra/deploy.py --apply     (CloudShell or any env-cred runner)

# ---- infra (used only inside AWS CloudShell / services; never in repo) ----
# ALERT_EMAIL=you@example.com     # SNS advisory recipient
